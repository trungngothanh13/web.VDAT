# VDAT Frontend Environment Configuration

# Backend REST API Base URL (leave empty or use /api if using Vite proxy)
VITE_API_URL=http://localhost:5000

# Backend WebSocket Stream URL
VITE_WS_URL=ws://localhost:5000/ws/client

# Default streaming camera ID
VITE_DEFAULT_CAMERA_ID=cam-01

# Enable simulated mock data when backend is unreachable
VITE_USE_MOCK_FALLBACK=false

